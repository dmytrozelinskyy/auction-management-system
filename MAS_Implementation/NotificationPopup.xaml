<Window x:Class="MAS_Implementation.NotificationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MAS_Implementation"
        mc:Ignorable="d"
        Title="NotificationPopup" Height="220" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#D9D9D9">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="White">
                <TextBlock x:Name="TitleText" Text="Error!"
                           FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="X" HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>
            </Grid>
            
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock x:Name="HeadlineText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="Black" TextWrapping="Wrap"
                           Margin="15,0,0,0"/>
                <TextBlock x:Name="DetailText"
                           FontSize="12" Foreground="#444"
                           TextWrapping="Wrap"
                           Margin="15,0,0,0"/>
            </StackPanel>
            
            <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0"/>
        </Grid>
    </Border>
</Window>
